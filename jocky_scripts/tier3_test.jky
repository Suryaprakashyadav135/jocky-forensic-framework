// Tier 3 tests

// Sort
let arr = split("zebra,apple,mango,banana", ",");
let sorted = sort(arr);
let joined = join(sorted, ",");
emit("sorted", joined);

// Reverse
let reversed = reverse(split("1,2,3,4,5", ","));
emit("reversed", join(reversed, ","));

// Slice
let sliced = slice(split("a,b,c,d,e", ","), 1, 4);
emit("sliced", join(sliced, ","));

// Unique
let dupes = split("a,b,a,c,b,d", ",");
let uniq = unique(dupes);
emit("unique", join(uniq, ","));

// Base64
let b64 = base64_encode("Hello, JOCKY");
emit("base64", b64);
let decoded = base64_decode(b64);
emit("decoded", decoded);

// Hex
let hexed = hex_encode("AB");
emit("hex", hexed);
let unhexed = hex_decode(hexed);
emit("unhexed", unhexed);

// SHA-256 of string
let h = sha256_string("test");
emit("sha256_test", h);

// SHA-256 of file
let fh = sha256_file("/etc/hostname");
emit("sha256_hostname", fh);
