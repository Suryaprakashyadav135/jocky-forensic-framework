// ioc_scan.jky --- Indicator of Compromise Hunting

let findings = 0;
let high_count = 0;
let medium_count = 0;
let low_count = 0;

// 1. Hash executables in /tmp
let tmp_dir = "/tmp";
let tmp_entries = list_dir(tmp_dir);
let hashed = 0;

for i in 0..len(tmp_entries) {
    let fname = tmp_entries[i];
    let fpath = tmp_dir + "/" + fname;
    let sz = file_size(fpath);
    if sz > 1000 {
        if sz < 50000000 {
            let h = sha256_file(fpath);
            if len(h) == 64 {
                emit("HASH", fname + "|" + h);
                hashed = hashed + 1;
            }
        }
    }
}
emit("STAT_files_hashed", hashed);

// 2. Scan .sh files in /tmp for suspicious content
for i in 0..len(tmp_entries) {
    let fname = tmp_entries[i];
    if ends_with(fname, ".sh") == 1 {
        let fpath = tmp_dir + "/" + fname;
        let content = read_file(fpath);
        if find(content, "curl ") > 0 {
            emit("FINDING", "HIGH|IOC|Shell_curl_payload|" + fname);
            findings = findings + 1;
            high_count = high_count + 1;
        }
        if find(content, "wget ") > 0 {
            emit("FINDING", "HIGH|IOC|Shell_wget_payload|" + fname);
            findings = findings + 1;
            high_count = high_count + 1;
        }
        if find(content, "base64 -d") > 0 {
            emit("FINDING", "HIGH|IOC|Shell_base64_decode|" + fname);
            findings = findings + 1;
            high_count = high_count + 1;
        }
    }
}

// 3. Extract IPs from shell history
let user = getenv("USER");
let hist = "/home/" + user + "/.bash_history";
if file_exists(hist) == 1 {
    let lines = read_file_lines(hist);
    for i in 0..len(lines) {
        let line = lines[i];
        let ip = match(line, "[0-9]+[.][0-9]+[.][0-9]+[.][0-9]+");
        if len(ip) > 0 {
            emit("FINDING", "LOW|IOC|History_IP|ip=" + ip);
            findings = findings + 1;
            low_count = low_count + 1;
        }
    }
}

// 4. Hash cron files (baseline)
let cron_d = "/etc/cron.d";
if file_exists(cron_d) == 1 {
    let files = list_dir(cron_d);
    for i in 0..len(files) {
        let fname = files[i];
        let fpath = cron_d + "/" + fname;
        let h = sha256_file(fpath);
        emit("HASH", "cron|" + fname + "|" + h);
    }
}

emit("STAT_total_findings", findings);
emit("STAT_high", high_count);
emit("STAT_medium", medium_count);
emit("STAT_low", low_count);
