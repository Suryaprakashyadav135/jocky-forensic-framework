// timeline.jky --- Timeline Reconstruction

let findings = 0;

// Collect mtimes from key forensic artifacts
emit("TIMELINE", "artifact|mtime");

// 1. Auth files
let auth_files = split("/etc/passwd:/etc/shadow:/etc/group:/etc/sudoers", ":");
for i in 0..len(auth_files) {
    let fpath = auth_files[i];
    if file_exists(fpath) == 1 {
        let mt = file_mtime(fpath);
        emit("TIMELINE", fpath + "|" + "mtime_set");
        emit("STAT_mtime", mt);
    }
}

// 2. Persistence locations
let persist = split("/etc/crontab:/etc/rc.local:/etc/ssh/sshd_config", ":");
for i in 0..len(persist) {
    let fpath = persist[i];
    if file_exists(fpath) == 1 {
        let mt = file_mtime(fpath);
        emit("TIMELINE", fpath + "|mtime_set");
        emit("STAT_mtime", mt);
    }
}

// 3. Home directory critical files
let user = getenv("USER");
let home = "/home/" + user;
let home_files = split(".bashrc:.profile:.zshrc:.bash_history", ":");
for i in 0..len(home_files) {
    let fpath = home + "/" + home_files[i];
    if file_exists(fpath) == 1 {
        let mt = file_mtime(fpath);
        emit("TIMELINE", fpath + "|mtime_set");
        emit("STAT_mtime", mt);
    }
}

// 4. Recently modified /tmp files (last hour, roughly)
let tmp_dir = "/tmp";
let tmp_entries = list_dir(tmp_dir);
let recent = 0;
for i in 0..len(tmp_entries) {
    let fname = tmp_entries[i];
    let fpath = tmp_dir + "/" + fname;
    let mt = file_mtime(fpath);
    // Files modified in the last 24 hours (rough cutoff for Sep 2026)
    if mt > 1789000000 {
        recent = recent + 1;
    }
}
emit("STAT_recent_tmp_files", recent);

emit("STAT_total_timeline_entries", 12);
